<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- enableOnBackInvokedCallback only exists from API 33 on; older versions ignore it and
         use onBackPressed, which MainActivity still handles. -->
    <application
        android:name=".ViewerApplication"
        android:enableOnBackInvokedCallback="true"
        tools:ignore="UnusedAttribute"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="@string/app_name"
        android:theme="@style/Theme.Rnote">

        <!-- The start screen: the notebooks of the library. -->
        <activity
            android:name=".LibraryActivity"
            android:exported="true"
            android:theme="@style/Theme.Rnote.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Handles rotation and resizing itself, so the open document survives them. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|keyboard|keyboardHidden|navigation|uiMode|fontScale|locale|layoutDirection"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="application/rnote" />
                <data android:mimeType="application/x-rnote" />
            </intent-filter>
        </activity>
    </application>
</manifest>
