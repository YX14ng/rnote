<?xml version="1.0" encoding="UTF-8"?>
<!-- ### The library: the home screen of the window ### -->
<interface>
  <menu id="library_menu">
    <section>
      <item>
        <attribute name="label" translatable="yes">Sort by Name</attribute>
        <attribute name="action">library.library-sort-by-name</attribute>
      </item>
    </section>
    <section>
      <item>
        <attribute name="label" translatable="yes">Library Folder…</attribute>
        <attribute name="action">library.choose-folder</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">Refresh</attribute>
        <attribute name="action">library.refresh</attribute>
      </item>
    </section>
    <section>
      <item>
        <attribute name="label" translatable="yes">Se_ttings</attribute>
        <attribute name="action">library.open-settings</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">_Keyboard Shortcuts</attribute>
        <attribute name="action">win.keyboard-shortcuts</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">A_bout Rnote</attribute>
        <attribute name="action">win.about</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">_Quit</attribute>
        <attribute name="action">app.quit</attribute>
      </item>
    </section>
  </menu>
  <template class="RnLibraryView" parent="GtkWidget">
    <property name="layout-manager">
      <object class="GtkBinLayout" />
    </property>
    <child>
      <object class="AdwToolbarView">
        <property name="top-bar-style">raised</property>
        <child type="top">
          <object class="AdwHeaderBar" id="headerbar">
            <property name="title-widget">
              <object class="AdwWindowTitle" id="title">
                <property name="title" translatable="yes">Library</property>
              </object>
            </property>
            <child type="start">
              <object class="GtkToggleButton">
                <property name="icon-name">sidebar-show-symbolic</property>
                <property name="tooltip-text" translatable="yes">Show/Hide Sidebar</property>
                <property name="active" bind-source="split" bind-property="show-sidebar" bind-flags="sync-create|bidirectional" />
              </object>
            </child>
            <child type="start">
              <object class="GtkButton">
                <property name="icon-name">view-grid-symbolic</property>
                <property name="action-name">win.show-editor</property>
                <property name="tooltip-text" translatable="yes">Open Tabs</property>
              </object>
            </child>
            <child type="end">
              <object class="GtkMenuButton">
                <property name="icon-name">open-menu-symbolic</property>
                <property name="menu-model">library_menu</property>
                <property name="tooltip-text" translatable="yes">Library Menu</property>
              </object>
            </child>
            <child type="end">
              <object class="GtkToggleButton" id="select_button">
                <property name="icon-name">selection-mode-symbolic</property>
                <property name="action-name">library.selection-mode</property>
                <property name="tooltip-text" translatable="yes">Select</property>
              </object>
            </child>
            <child type="end">
              <object class="GtkMenuButton" id="section_menu_button">
                <property name="icon-name">view-more-symbolic</property>
                <property name="visible">false</property>
                <property name="tooltip-text" translatable="yes">Section Menu</property>
              </object>
            </child>
            <child type="end">
              <object class="GtkButton" id="empty_trash_button">
                <property name="label" translatable="yes">Empty Trash</property>
                <property name="action-name">library.empty-trash</property>
                <property name="visible">false</property>
                <style>
                  <class name="destructive-action" />
                </style>
              </object>
            </child>
            <child type="end">
              <object class="GtkToggleButton">
                <property name="icon-name">view-list-symbolic</property>
                <property name="action-name">library.library-list-view</property>
                <property name="tooltip-text" translatable="yes">List View</property>
              </object>
            </child>
          </object>
        </child>
        <child type="bottom">
          <object class="GtkActionBar" id="selection_bar">
            <property name="revealed">false</property>
            <child type="start">
              <object class="GtkLabel" id="selection_label" />
            </child>
            <child type="end">
              <object class="GtkButton">
                <property name="label" translatable="yes">Move to Trash</property>
                <property name="action-name">library.selection-trash</property>
                <style>
                  <class name="destructive-action" />
                </style>
              </object>
            </child>
            <child type="end">
              <object class="GtkButton">
                <property name="label" translatable="yes">Tags…</property>
                <property name="action-name">library.selection-tags</property>
              </object>
            </child>
            <child type="end">
              <object class="GtkMenuButton" id="selection_move_button">
                <property name="label" translatable="yes">Move to</property>
              </object>
            </child>
          </object>
        </child>
        <property name="content">
          <object class="GtkStack" id="stack">
            <property name="transition-type">crossfade</property>
            <child>
              <object class="GtkStackPage">
                <property name="name">content</property>
                <property name="child">
                  <object class="AdwOverlaySplitView" id="split">
                    <property name="min-sidebar-width">200</property>
                    <property name="max-sidebar-width">280</property>
                    <property name="sidebar">
                      <object class="GtkScrolledWindow">
                        <property name="hscrollbar-policy">never</property>
                        <property name="child">
                          <object class="GtkListBox" id="sidebar_list">
                            <property name="selection-mode">single</property>
                            <style>
                              <class name="navigation-sidebar" />
                            </style>
                          </object>
                        </property>
                      </object>
                    </property>
                    <property name="content">
                      <object class="GtkScrolledWindow">
                        <property name="hscrollbar-policy">never</property>
                        <property name="child">
                          <object class="GtkFlowBox" id="flowbox">
                            <property name="valign">start</property>
                            <property name="selection-mode">none</property>
                            <property name="homogeneous">true</property>
                            <property name="column-spacing">18</property>
                            <property name="row-spacing">18</property>
                            <property name="margin-start">18</property>
                            <property name="margin-end">18</property>
                            <property name="margin-top">18</property>
                            <property name="margin-bottom">18</property>
                            <property name="max-children-per-line">12</property>
                          </object>
                        </property>
                      </object>
                    </property>
                  </object>
                </property>
              </object>
            </child>
            <child>
              <object class="GtkStackPage">
                <property name="name">error</property>
                <property name="child">
                  <object class="AdwStatusPage" id="error_page">
                    <property name="icon-name">dialog-warning-symbolic</property>
                    <property name="title" translatable="yes">The Library Can’t Be Opened</property>
                    <property name="child">
                      <object class="GtkButton">
                        <property name="label" translatable="yes">Choose Folder…</property>
                        <property name="action-name">library.choose-folder</property>
                        <property name="halign">center</property>
                        <style>
                          <class name="pill" />
                          <class name="suggested-action" />
                        </style>
                      </object>
                    </property>
                  </object>
                </property>
              </object>
            </child>
          </object>
        </property>
      </object>
    </child>
  </template>
</interface>
