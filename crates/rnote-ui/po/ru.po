#: crates/rnote-ui/data/app.metainfo.xml.in.in:628
msgid "long awaited: write and edit text with the typewriter"
msgstr ""
"долгожданное: ввод и редактирование текста с помощью инструмента «Текст»"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:629
