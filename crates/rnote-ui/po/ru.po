#: crates/rnote-ui/data/app.metainfo.xml.in.in:95
msgid "fix: transparent stroke rendering (@Kneemund)"
msgstr "исправление: отрисовка прозрачных штрихов (@Kneemund)"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:96
msgid "fix: document not staying centered after zooming (@Kneemund)"
msgstr ""
"исправление: документ не оставался по центру после масштабирования "
"(@Kneemund)"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:97
msgid "fix: pinch zooming on touchscreen (@Kneemund)"
msgstr "исправление: масштабирование щипком на сенсорном экране (@Kneemund)"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:98
msgid "fix: jumping view while zooming in (@Kneemund)"
msgstr "исправление: скачки вида при увеличении масштаба (@Kneemund)"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:99
msgid "fix: zooming with \"alt+shift+drag\" (@Kneemund)"
msgstr ""
"исправление: масштабирование с помощью «alt+shift+перетаскивание» (@Kneemund)"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:107
msgid ""
"fix: fixed icon appearance and update to new, more consistent style (@flxzt)"
msgstr ""
"исправление: исправлен внешний вид значков, они обновлены до нового, более "
"единообразного стиля (@flxzt)"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:108
msgid "fix: file erroneously detected as removed after saving (@turicfr)"
msgstr ""
"исправление: файл ошибочно считался удалённым после сохранения (@turicfr)"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:109
msgid ""
"fix: pinch-to-zoom causing scroll by applying workaround for GTK issue "
"(@RayJW)"
msgstr ""
"исправление: масштабирование щипком вызывало прокрутку; применён обходной "
"путь для ошибки GTK (@RayJW)"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:110
msgid "fix: zooming with Ctrl+Scroll while Capslock is turned on (@Kneemund)"
msgstr ""
"исправление: масштабирование с помощью Ctrl+прокрутка при включённом Caps "
"Lock (@Kneemund)"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:111
msgid "fix: grid snapping for all pattern styles (@Kneemund)"
msgstr "исправление: привязка к сетке для всех стилей линовки (@Kneemund)"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:119
msgid "feat: apply workspace entry dialog by pressing Enter (@ternison)"
msgstr "новое: подтверждение диалога коллекции нажатием Enter (@ternison)"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:120
msgid "feat: add text formatting keyboard shortcuts (@ Keschler)"
msgstr "новое: комбинации клавиш для форматирования текста (@ Keschler)"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:121
msgid "feat: Xournal++ text import (@Doublonmousse)"
msgstr "новое: импорт текста из Xournal++ (@Doublonmousse)"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:122
msgid ""
"fix: PDF rendering issues by replace underlying library (from poppler to "
"hayro) (@flxzt)"
msgstr ""
"исправление: проблемы с отрисовкой PDF благодаря замене библиотеки (poppler "
"на hayro) (@flxzt)"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:123
msgid "feat: CLI create command (@DarshPareek)"
msgstr "новое: команда create в командной строке (@DarshPareek)"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:124
msgid "feat: CLI thumbnail generation timeout (@flxzt)"
msgstr "новое: тайм-аут создания миниатюр в командной строке (@flxzt)"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:125
msgid "feat: bundle CLI in flatpak (@flxzt)"
msgstr "новое: утилита командной строки включена во flatpak (@flxzt)"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:126
msgid "feat: atomic file saving (@anesthetice)"
msgstr "новое: атомарное сохранение файлов (@anesthetice)"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:127
msgid "improv: pen eraser default (@DorianRudolph)"
msgstr "улучшение: поведение ластика пера по умолчанию (@DorianRudolph)"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:128
msgid ""
"improv: improve initial focus for import/export dialogs (@Doublonmousse)"
msgstr ""
"улучшение: начальный фокус в диалогах импорта и экспорта (@Doublonmousse)"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:129
msgid ""
"fix: file picker stealing focus from all opened windows (@Doublonmousse)"
msgstr ""
"исправление: окно выбора файла забирало фокус у всех открытых окон "
"(@Doublonmousse)"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:130
msgid "fix: pen sounds on Windows (@Doublonmousse)"
msgstr "исправление: звуки пера в Windows (@Doublonmousse)"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:131
msgid ""
"fix: prevent crash when sorting files with non UTF-8 names (@Doublonmousse)"
msgstr ""
"исправление: сбой при сортировке файлов с именами не в UTF-8 (@Doublonmousse)"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:132
msgid "fix: rnote thumbnailer execution (@flxzt)"
msgstr "исправление: запуск генератора миниатюр rnote (@flxzt)"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:133
msgid "fix: workspace directory default (@flxzt)"
msgstr "исправление: каталог коллекции по умолчанию (@flxzt)"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:141
msgid "fix: occasional PDF import failure (thanks to @Doublonmousse)"
msgstr "исправление: периодические сбои импорта PDF (спасибо @Doublonmousse)"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:142
msgid ""
"fix: add back accidentally removed 'Pen Style' keyboard shortcuts (thanks to "
"@Doublonmousse)"
msgstr ""
"исправление: возвращены случайно удалённые комбинации клавиш «Стиль пера» "
"(спасибо @Doublonmousse)"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:150
msgid "feat: save/restore engine configuration with preset"
msgstr ""
"новое: сохранение и восстановление конфигурации движка с помощью пресета"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:151
msgid "feat: respect snap-positions option when building shapes"
msgstr "новое: учёт параметра привязки к точкам при построении фигур"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:152
msgid ""
"feat: shape styling options and shape highlight-mode (thanks to @anesthetice)"
msgstr ""
"новое: параметры стиля фигур и режим подсветки фигур (спасибо @anesthetice)"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:153
msgid ""
"improv: application window always focused when opening a file (thanks to "
"@Nugfle)"
msgstr ""
"улучшение: окно приложения всегда получает фокус при открытии файла (спасибо "
"@Nugfle)"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:154
msgid ""
"fix: selected part when renaming files in the application file browser "
"(thanks to @Kneemund)"
msgstr ""
"исправление: выделяемая часть имени при переименовании файлов во встроенном "
"обозревателе файлов (спасибо @Kneemund)"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:155
msgid ""
"fix: cancelling import dialogs not stopping progress bar (thanks to "
"@Doublonmousse)"
msgstr ""
"исправление: отмена диалогов импорта не останавливала индикатор выполнения "
"(спасибо @Doublonmousse)"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:156
msgid "fix: missing translation for a string (thanks to @Doublonmousse)"
msgstr ""
"исправление: отсутствовал перевод одной строки (спасибо @Doublonmousse)"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:157
msgid ""
"fix: save file logic when encountering corner cases (thanks to "
"@Doublonmousse)"
msgstr ""
"исправление: логика сохранения файлов в пограничных случаях (спасибо "
"@Doublonmousse)"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:158
msgid "fix: filename sorting in integrated files list"
msgstr "исправление: сортировка по имени файла во встроенном списке файлов"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:159
msgid "fix: prevent occasional xopp import failure"
msgstr "исправление: предотвращены периодические сбои импорта xopp"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:167
msgid "feat: laser tool with animations (thanks to @Kneemund)"
msgstr "новое: инструмент «Лазер» с анимациями (спасибо @Kneemund)"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:168
msgid "feat: tab overviews (thanks to @zefr0x)"
msgstr "новое: обзор вкладок (спасибо @zefr0x)"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:169
msgid "feat: thumbnailer for .rnote files (thanks to @tiziodcaio)"
msgstr "новое: генератор миниатюр для файлов .rnote (спасибо @tiziodcaio)"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:170
msgid ""
"feat: keyboard clipboard paste at pointer location (thanks to @Kneemund)"
msgstr ""
"новое: вставка из буфера обмена с клавиатуры в позицию указателя (спасибо "
"@Kneemund)"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:171
msgid "feat: multi-click selections (thanks to @Kneemund)"
msgstr "новое: выделение несколькими щелчками (спасибо @Kneemund)"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:172
msgid ""
"feat: new limit movements options for vertical-space tool (thanks to "
"@Doublonmousse)"
msgstr ""
"новое: параметры ограничения перемещения для инструмента вертикального "
"пробела (спасибо @Doublonmousse)"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:173
msgid ""
"feat: confirmation prompt for file/folder trash action (thanks to @RayJW)"
msgstr ""
"новое: запрос подтверждения при удалении файла или папки в корзину (спасибо "
"@RayJW)"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:174
msgid "feat: open workspace folder option (thanks to @Doublonmousse)"
msgstr "новое: возможность открыть папку коллекции (спасибо @Doublonmousse)"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:175
msgid "feat: import of encrypted PDFs (thanks to @kq98)"
msgstr "новое: импорт зашифрованных PDF (спасибо @kq98)"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:176
msgid ""
"improv: support keyboard and uncommon key shortcuts (thanks to @Kneemund)"
msgstr ""
"улучшение: поддержка клавиатурных и необычных комбинаций клавиш (спасибо "
"@Kneemund)"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:177
msgid ""
"improv: clipboard pasting on certain platforms like macOS (thanks to "
"@Doublonmousse)"
msgstr ""
"улучшение: вставка из буфера обмена на некоторых платформах, например macOS "
"(спасибо @Doublonmousse)"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:178
msgid "fix: selection handle sensitivity in \"single-selection\" mode"
msgstr "исправление: чувствительность маркеров выделения в режиме «по одному»"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:179
msgid ""
"fix: unwanted activation of long-press gesture after zooming (thanks to "
"@Kneemund)"
msgstr ""
"исправление: нежелательное срабатывание жеста долгого нажатия после "
"масштабирования (спасибо @Kneemund)"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:180
msgid "fix: allow view movement while having a selection"
msgstr "исправление: разрешено перемещать вид при наличии выделения"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:181
msgid ""
"fix: cli file collision resolution in non-interactive settings (thanks to "
"@LeSnake04)"
msgstr ""
"исправление: разрешение конфликтов файлов в командной строке в "
"неинтерактивном режиме (спасибо @LeSnake04)"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:182
msgid "fix: missing tooltips (thanks to @Doublonmousse)"
msgstr ""
"исправление: отсутствующие всплывающие подсказки (спасибо @Doublonmousse)"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:183
msgid "fix: window shadows on Windows (thanks to @Doublonmousse)"
msgstr "исправление: тени окон в Windows (спасибо @Doublonmousse)"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:184
msgid "fix: .rnote file icons in file managers"
msgstr "исправление: значки файлов .rnote в файловых менеджерах"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:185
msgid ""
"fix: selecting colors not working properly in certain cases (thanks to "
"@Kneemund)"
msgstr ""
"исправление: в некоторых случаях выбор цвета работал неправильно (спасибо "
"@Kneemund)"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:193
msgid "feat: add disable option for pen shortcuts (thanks to @Doublonmousse)"
msgstr ""
"новое: возможность отключить комбинации клавиш пера (спасибо @Doublonmousse)"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:194
msgid ""
"feat: add respect-borders option, improving size logic when pasting content "
"(thanks to @Doublonmousse)"
msgstr ""
"новое: параметр учёта границ, улучшающий расчёт размера при вставке "
"содержимого (спасибо @Doublonmousse)"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:195
msgid ""
"feat: add improve-for-E-Paper option, showing current selected color as a "
"string"
msgstr ""
"новое: параметр оптимизации для электронной бумаги, показывающий текущий "
"выбранный цвет текстом"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:196
msgid "improv: migrate to libadwaita based dialogs (thanks to @zefr0x)"
msgstr "улучшение: переход на диалоги libadwaita (спасибо @zefr0x)"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:197
msgid ""
"improv: stroke modeler entirely rewritten in Rust! (thanks to @Doublonmousse)"
msgstr ""
"улучшение: модуль моделирования штрихов полностью переписан на Rust! "
"(спасибо @Doublonmousse)"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:198
msgid "improv: zoom tool following the pointer (thanks to @JonathanGodar)"
msgstr ""
"улучшение: инструмент масштабирования следует за указателем (спасибо "
"@JonathanGodar)"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:199
msgid "improv: developers list in about window (thanks to @zefr0x)"
msgstr "улучшение: список разработчиков в окне «О программе» (спасибо @zefr0x)"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:200
msgid ""
"improv: native file dialogs on Windows, macOS (thanks to @Doublonmousse)"
msgstr ""
"улучшение: системные диалоги выбора файлов в Windows и macOS (спасибо "
"@Doublonmousse)"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:201
msgid ""
"improv: gzip (de)compression optimizations, reducing file save/load times "
"(thanks to @anesthetice)"
msgstr ""
"улучшение: оптимизация сжатия и распаковки gzip, ускоряющая сохранение и "
"загрузку файлов (спасибо @anesthetice)"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:202
msgid ""
"improv: prevent accidental resizes/moves when interacting with buttons in "
"the titlebar"
msgstr ""
"улучшение: предотвращены случайные изменения размера и перемещения окна при "
"нажатии кнопок в заголовке"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:203
msgid "improv: inhibit app close while saves are in progress"
msgstr "улучшение: приложение не закрывается, пока идёт сохранение"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:204
msgid ""
"improv: ability to change text selection colors inside a single text box"
msgstr ""
"улучшение: возможность менять цвет выделенного текста внутри одного "
"текстового блока"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:205
msgid "fix: pen state becoming incorrect on windows (thanks to @Doublonmousse)"
msgstr ""
"исправление: неверное состояние пера в Windows (спасибо @Doublonmousse)"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:206
msgid "fix: file extension filters in dialogs (thanks to @Doublonmousse)"
msgstr ""
"исправление: фильтры расширений файлов в диалогах (спасибо @Doublonmousse)"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:207
msgid ""
"fix: force the gtk renderer to gl for now, fixing recurring crashes for some "
"users (thanks to @Doublonmousse)"
msgstr ""
"исправление: отрисовщик GTK временно принудительно переключён на GL, что "
"устраняет регулярные сбои у некоторых пользователей (спасибо @Doublonmousse)"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:208
msgid "fix: two-finger long-press gesture causing crashes for some users"
msgstr ""
"исправление: жест долгого нажатия двумя пальцами вызывал сбои у некоторых "
"пользователей"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:209
msgid "fix: single element stroke not generating hitboxes"
msgstr ""
"исправление: для штрихов из одного элемента не создавались области попадания"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:210
msgid ""
"fix: scrolls being captured by unit-entries in settings, causing accidental "
"value changes"
msgstr ""
"исправление: поля с единицами измерения в настройках перехватывали "
"прокрутку, из-за чего значения случайно менялись"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:211
msgid "fix: hover state for typewriter move/resize nodes"
msgstr ""
"исправление: состояние наведения на узлы перемещения и изменения размера в "
"инструменте «Текст»"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:219
msgid ""
"improv: put handles outside of selection borders, enable resizing to smaller "
"sizes (thanks to @Doublonmousse)"
msgstr ""
"улучшение: маркеры вынесены за границы выделения, теперь можно уменьшать до "
"меньших размеров (спасибо @Doublonmousse)"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:220
msgid ""
"improv: error notification when file operations fail in workspace browser"
msgstr ""
"улучшение: уведомление об ошибке при сбое файловых операций в обозревателе "
"коллекции"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:221
msgid "metainfo: add brand colors (thanks to @bertob)"
msgstr "метаданные: добавлены фирменные цвета (спасибо @bertob)"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:222
msgid "fix: origin indicator cross size on hi-dpi screens"
msgstr ""
"исправление: размер крестика начала документа на экранах с высокой "
"плотностью пикселей"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:223
msgid "fix: rendering got out of sync when resizing long-to-render content"
msgstr ""
"исправление: рассинхронизация отрисовки при изменении размера долго "
"отрисовываемого содержимого"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:224
msgid "fix: selection stroke widths got larger when resizing non-uniformly"
msgstr ""
"исправление: толщина штрихов в выделении увеличивалась при неравномерном "
"изменении размера"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:225
msgid ""
"fix: regression which caused excessive rerendering of selection during "
"resizing"
msgstr ""
"исправление: регрессия, из-за которой выделение избыточно перерисовывалось "
"при изменении размера"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:233
msgid ""
"fix: importing images changed document dimensions when `adjust-document` pdf "
"import setting is set"
msgstr ""
"исправление: импорт изображений менял размеры документа, если включён "
"параметр импорта PDF «adjust-document»"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:234
msgid ""
"fix: windows installer now includes EGL/GLES libraries, fixing launch error "
"when they are present elsewhere but in PATH"
msgstr ""
"исправление: установщик для Windows теперь включает библиотеки EGL/GLES, что "
"устраняет ошибку запуска, если они есть где-то ещё в PATH"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:242
msgid "feat: touch-hold context-menu with basic actions (thanks to @silvasch)"
msgstr ""
"новое: контекстное меню по долгому касанию с основными действиями (спасибо "
"@silvasch)"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:243
msgid "feat: added polygon shape and builder"
msgstr "новое: фигура «Многоугольник» и её конструктор"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:244
msgid ""
"feat: added adjust-document Pdf import option that configures the document "
"for improved annotation use-case"
msgstr ""
"новое: параметр импорта PDF «adjust-document», который настраивает документ "
"для удобного аннотирования"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:245
msgid "improv: additional color button (default: white) (thanks to @silvasch)"
msgstr ""
"улучшение: дополнительная кнопка цвета (по умолчанию белый) (спасибо "
"@silvasch)"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:246
msgid ""
"improv: new keyboard shortcuts for managing windows and tabs (thanks to "
"@silvasch)"
msgstr ""
"улучшение: новые комбинации клавиш для управления окнами и вкладками "
"(спасибо @silvasch)"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:247
msgid ""
"improv: autosave all tabs, but only ones that are flagged modified (thanks "
"to @Doublonmousse)"
msgstr ""
"улучшение: автосохранение всех вкладок, но только тех, что были изменены "
"(спасибо @Doublonmousse)"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:248
msgid ""
"improv: don't export empty layers when exporting to xopp (thanks to "
"@Doublonmousse)"
msgstr ""
"улучшение: пустые слои не экспортируются при экспорте в xopp (спасибо "
"@Doublonmousse)"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:249
msgid ""
"improv: workspace browser is now separated into three sections: folders - "
"rnote notes - other importable files"
msgstr ""
"улучшение: обозреватель коллекции теперь разделён на три раздела: папки, "
"заметки rnote и другие файлы для импорта"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:250
msgid "improv: use start aspect ratio when resizing and locking aspect-ratio"
msgstr ""
"улучшение: при изменении размера с фиксированным соотношением сторон "
"используется исходное соотношение"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:251
msgid ""
"improv: renaming file in workspace browser selects only file stem initially"
msgstr ""
"улучшение: при переименовании файла в обозревателе коллекции сначала "
"выделяется только имя без расширения"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:252
msgid "improv: move document-layout option from canvas-menu to settings"
msgstr ""
"улучшение: параметр компоновки документа перенесён из меню холста в настройки"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:253
msgid ""
"improv: reduce repaints - when stroke is finished, cache origin-indicator "
"rendering"
msgstr ""
"улучшение: меньше перерисовок — после завершения штриха отрисовка индикатора "
"начала документа кешируется"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:254
msgid "improv: added new-window menu entry"
msgstr "улучшение: добавлен пункт меню «Новое окно»"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:255
msgid ""
"improv: file watcher implementation and rnote file writing, possibly fixing "
"\"reload document\" toasts when file is saved on windows"
msgstr ""
"улучшение: отслеживание изменений файлов и запись файлов rnote, что, "
"возможно, устраняет уведомления «перезагрузить документ» после сохранения в "
"Windows"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:256
msgid ""
"fix: failing export/clipboard-copy with large images (thanks to "
"@Doublonmousse)"
msgstr ""
"исправление: сбой экспорта и копирования в буфер обмена с большими "
"изображениями (спасибо @Doublonmousse)"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:257
msgid ""
"fix: menus positions when opened through keyboard shortcut (thanks to "
"@detiam)"
msgstr ""
"исправление: положение меню, открытых комбинацией клавиш (спасибо @detiam)"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:258
msgid "fix: zoom label not being updated after switching tab"
msgstr "исправление: метка масштаба не обновлялась после переключения вкладки"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:259
msgid "fix: regression where margin is not applied when exporting selection"
msgstr ""
"исправление: регрессия, при которой поле не применялось при экспорте "
"выделения"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:260
msgid "fix: undo/redo triggering document-modified flag"
msgstr "исправление: отмена и повтор помечали документ как изменённый"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:268
msgid ""
"ux: increase window threshold width at where the sidebar becomes an overlay"
msgstr ""
"удобство: увеличена ширина окна, при которой боковая панель становится "
"наложением"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:269
msgid ""
"fix: indicate unsaved when changing document settings (format, colors, "
