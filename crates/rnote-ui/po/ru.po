#: crates/rnote-ui/data/app.metainfo.xml.in.in:507
msgid "fix: layers when erasing marker strokes in \"split-stroke\" mode"
msgstr ""
"исправление: слои при стирании штрихов маркера в режиме «разделять штрихи»"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:508
msgid "fix: \"split-stroke\" mode only eraser one segment at a time"
msgstr ""
"исправление: режим «разделять штрихи» стирал только один сегмент за раз"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:509
msgid "fix: freeze when saving multiple times in succession"
msgstr "исправление: зависание при многократном сохранении подряд"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:510
msgid "fix: blurry vector images after zooming in"
msgstr "исправление: размытые векторные изображения после увеличения масштаба"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:511
msgid "fix: some blurry icons"
msgstr "исправление: некоторые размытые значки"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:519
msgid "UI: minor sidebar tweaks"
msgstr "интерфейс: небольшие доработки боковой панели"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:520
msgid "i18n: updated strings and translations"
msgstr "локализация: обновлены строки и переводы"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:521
msgid "fix: remove selection bounds margins"
msgstr "исправление: убраны поля у границ выделения"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:522
