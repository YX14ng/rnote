#: crates/rnote-ui/data/app.metainfo.xml.in.in:632
msgid "proportial shapes / input constraints (thanks @sei0o!)"
msgstr "пропорциональные фигуры и ограничения ввода (спасибо @sei0o!)"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:633
