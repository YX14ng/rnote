msgstr "улучшение: более читаемые имена в строках файлов"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:283
msgid "improvement: add keyboard shortcut for snap-positions action"
msgstr "улучшение: комбинация клавиш для привязки к точкам"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:284
msgid "improvement: pdf import option to toggle page borders"
msgstr "улучшение: параметр импорта PDF для включения границ страниц"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:285
msgid ""
"fix: don't export empty pages that are adjacent to content that is snapped "
