#: crates/rnote-ui/data/app.metainfo.xml.in.in:530
msgid "feature: added a grid builder"
msgstr "новое: конструктор сетки"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:531
msgid ""
"feature: ctrl + pointer drag for panning the canvas, ctrl+shift + pointer "
