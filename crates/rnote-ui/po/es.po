#: crates/rnote-ui/data/app.metainfo.xml.in.in:551
msgid "faster start up times"
msgstr "tiempos de inicio más rápidos"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:552
msgid "switch to the typewriter when dropping text"
msgstr "cambiar a la máquina de escribir al soltar texto"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:553
msgid "more icon improvements (thanks @bertob !)"
msgstr "más mejoras en los iconos (gracias a @bertob)"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:554
msgid "fix: view \"jumps\" when quickly zooming multiple times"
msgstr ""
"corrección: \"saltos\" de la vista al hacer zoom varias veces rápidamente"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:555
msgid "fix: typewriter now handles cut (Ctrl + x) properly"
msgstr ""
"corrección: la máquina de escribir ahora gestiona correctamente el corte "
"(Ctrl + x)"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:563
msgid ""
"feature: added keyboard shortcuts \"Ctrl+1..6\" to switch between the "
"different pens"
msgstr ""
"novedad: atajos de teclado \"Ctrl+1..6\" para cambiar entre los distintos "
"lápices"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:564
msgid "feature: added coordinate system builders (thanks to @Kneemund )"
msgstr ""
"novedad: constructores de sistemas de coordenadas (gracias a @Kneemund)"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:565
msgid "feature: drop text on the canvas"
msgstr "novedad: soltar texto en el lienzo"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:566
msgid "improvement: export preferences, new export dialogs and options"
msgstr ""
"mejora: preferencias de exportación, nuevos diálogos y opciones de "
"exportación"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:567
msgid ""
"improvement: UI following Gnome HIG more closely ( with @bertob's help )"
msgstr ""
"mejora: la interfaz sigue más de cerca las HIG de Gnome (con la ayuda de "
"@bertob)"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:568
msgid ""
"fix: update current document state when the file was modified from the "
"workspace browser. (thanks @Kneemund )"
msgstr ""
"corrección: actualizar el estado del documento actual cuando el archivo se "
"modificaba desde el explorador del área de trabajo. (gracias a @Kneemund)"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:570
msgid "fix: clearing text attributes for new text fields"
msgstr ""
"corrección: limpiar los atributos de texto en los campos de texto nuevos"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:578
msgid "improvement: Add zoom buttons to the quick-actions overlay"
msgstr "mejora: botones de zoom en la capa de acciones rápidas"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:579
msgid ""
"improvement: By default use the workspace directory for import and export "
"dialogs, and document file for save dialogs"
msgstr ""
"mejora: de forma predeterminada se usa el directorio del área de trabajo en "
"los diálogos de importación y exportación, y el archivo del documento en los "
"diálogos de guardado"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:581
msgid "fix: Pdf export and print sometimes produced empty pages"
msgstr ""
"corrección: la exportación a PDF y la impresión a veces producían páginas "
"vacías"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:582
msgid ""
"fix: workspace files list not refreshing after modifying the workspace path"
msgstr ""
"corrección: la lista de archivos del área de trabajo no se actualizaba tras "
"modificar la ruta del área de trabajo"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:583
msgid ""
"fix: Selector being canceled when attempting to interact with the selection "
"when \"touch-drawing\" was enabled"
msgstr ""
"corrección: el seleccionador se cancelaba al intentar interactuar con la "
"selección cuando el \"dibujo táctil\" estaba activado"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:592
msgid ""
"feature: a new brush option to select between different path modelers. Added "
"a physics-based modelling type (as default) which decreases jitter and "
"improves handwriting smoothness. It also includes a predictor to minimize "
"input lag."
msgstr ""
"novedad: una nueva opción de la brocha para elegir entre distintos "
"modeladores de trazado. Se añadió un tipo de modelado basado en la física "
"(predeterminado) que reduce las vibraciones y mejora la suavidad de la "
"escritura a mano. También incluye un predictor para minimizar el retraso de "
"entrada."

#: crates/rnote-ui/data/app.metainfo.xml.in.in:595
msgid ""
"feature: switch between different cursors while hovering and drawing, with "
"new \"teardrop\", \"crosshair\" and \"beam\" cursors in different variations "
"and sizes."
msgstr ""
"novedad: cambiar entre distintos cursores al pasar el cursor por encima y al "
"dibujar, con los nuevos cursores \"lágrima\", \"punto de mira\" y \"haz\" en "
"distintas variantes y tamaños."

#: crates/rnote-ui/data/app.metainfo.xml.in.in:597
msgid ""
"feature: a new `duplicate` file action and a new `create directory` "
"workspace action (thanks @TornaxO7 !)"
msgstr ""
"novedad: una nueva acción de archivo `duplicate` y una nueva acción del área "
"de trabajo `create directory` (gracias a @TornaxO7)"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:599
msgid "improved: better palm rejection while drawing with a stylus"
msgstr "mejora: mejor rechazo de la palma al dibujar con un lápiz óptico"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:600
msgid "improved: better export filenames"
msgstr "mejora: mejores nombres de archivo al exportar"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:601
msgid ""
"improved: typewriter input now accepts letter accents, improved unicode "
"support"
msgstr ""
"mejora: la entrada de la máquina de escribir ahora acepta letras con tilde; "
"compatibilidad con Unicode mejorada"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:602
msgid "fix: background pattern tile rendering size"
msgstr "corrección: tamaño de renderizado de los mosaicos del patrón de fondo"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:603
msgid ""
"fix: scrolling with touchpad was not possible when the \"permanent hidden "
