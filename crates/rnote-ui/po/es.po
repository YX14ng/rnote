msgstr ""
"corrección: no se podía desplazar con el panel táctil cuando estaba activada "
"la opción \"ocultar permanentemente las barras de desplazamiento\""

#: crates/rnote-ui/data/app.metainfo.xml.in.in:605
msgid "fix: broken Svg export"
msgstr "corrección: exportación SVG rota"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:606
