#: crates/rnote-ui/data/app.metainfo.xml.in.in:220
msgid ""
"improv: error notification when file operations fail in workspace browser"
msgstr ""
"mejora: notificación de error cuando fallan las operaciones de archivo en el "
"explorador del área de trabajo"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:221
