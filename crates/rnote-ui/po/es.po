#: crates/rnote-ui/data/app.metainfo.xml.in.in:510
msgid "fix: blurry vector images after zooming in"
msgstr "corrección: imágenes vectoriales borrosas después de acercar"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:511
msgid "fix: some blurry icons"
msgstr "corrección: algunos iconos borrosos"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:519
msgid "UI: minor sidebar tweaks"
msgstr "IU: pequeños ajustes en la barra lateral"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:520
msgid "i18n: updated strings and translations"
msgstr "i18n: cadenas y traducciones actualizadas"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:521
