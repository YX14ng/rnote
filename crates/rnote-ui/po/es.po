#: crates/rnote-ui/data/app.metainfo.xml.in.in:378
msgid ""
"fix: import dialogs were not shown when importing files or drag-and-drop "
"from file-managers (thanks to @Kneemund)"
msgstr ""
"corrección: no se mostraban los diálogos de importación al importar archivos "
"o al arrastrarlos y soltarlos desde administradores de archivos (gracias a "
"@Kneemund)"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:386
msgid ""
"installation: windows users - the installer now uses 64-bit mode, and now "
"(correctly) installs into \"Program Files\" by default. If you are upgrading "
"from a previous version, you need to uninstall the old version in \"Program "
"Files (x86)\" manually."
msgstr ""
"instalación: usuarios de Windows - el instalador ahora usa el modo de 64 "
"bits y (correctamente) instala en \"Program Files\" de forma predeterminada. "
"Si actualiza desde una versión anterior, debe desinstalar manualmente la "
"versión antigua de \"Program Files (x86)\"."

#: crates/rnote-ui/data/app.metainfo.xml.in.in:388
msgid "feature: remove page from fixed size document (thanks to @PhilDevProg)"
msgstr ""
"novedad: eliminar páginas de un documento de tamaño fijo (gracias a "
"@PhilDevProg)"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:389
msgid ""
"feature: specify page order when exporting documents with layouts that "
"expand in horizontal and vertical directions (thanks to @Kneemund)"
msgstr ""
"novedad: especificar el orden de las páginas al exportar documentos con "
"disposiciones que se expanden en horizontal y en vertical (gracias a "
"@Kneemund)"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:390
msgid "feature: inertial touch scrolling (thanks to @Kneemund)"
msgstr "novedad: desplazamiento táctil inercial (gracias a @Kneemund)"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:391
msgid "feature: ability to toggle drawing cursor visibility"
msgstr "novedad: posibilidad de mostrar u ocultar el cursor de dibujo"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:392
msgid ""
"feature: \"focus mode\" that hides the toolbars, improving the experience on "
"low-resolution tablets"
msgstr ""
"novedad: \"modo concentración\", que oculta las barras de herramientas y "
"mejora la experiencia en tabletas de baja resolución"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:393
msgid ""
"feature: dedicated zoom tool, making navigating while touch-drawing is "
"enabled easier"
msgstr ""
"novedad: herramienta de zoom dedicada, que facilita la navegación cuando el "
"dibujo táctil está activado"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:394
msgid "improvement: selection highlights for brush-strokes"
msgstr "mejora: resaltado de la selección para los trazos de brocha"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:395
msgid "improvement: ctrl + scroll following the pointer"
msgstr "mejora: ctrl + desplazamiento sigue al puntero"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:396
msgid ""
"improvement: scale-ratio when resizing the selection with locked aspect-ratio"
msgstr ""
"mejora: proporción de escala al redimensionar la selección con la relación "
"de aspecto bloqueada"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:397
msgid ""
"improvement: provide selection content as Svg and Png when copying/cutting "
"to the clipboard"
msgstr ""
"mejora: el contenido de la selección se ofrece como SVG y PNG al "
"copiar/cortar al portapapeles"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:398
msgid "improvement: save file logic in close tab/window dialogs"
msgstr ""
"mejora: lógica de guardado de archivos en los diálogos de cierre de "
"pestaña/ventana"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:399
msgid "improvement: memory consumption when loading rnote files"
msgstr "mejora: consumo de memoria al cargar archivos rnote"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:400
msgid ""
"UI: page controls for the fixed-size layout were moved into the canvas menu "
"dropdown"
msgstr ""
"IU: los controles de página de la disposición de tamaño fijo se movieron al "
"menú desplegable del lienzo"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:401
msgid "UI: undo/redo buttons were moved to the pen switcher toolbar"
msgstr ""
"IU: los botones de deshacer/rehacer se movieron a la barra de herramientas "
"del selector de lápices"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:402
msgid "fix: apply pressure curves when exporting to xopp"
msgstr "corrección: aplicar las curvas de presión al exportar a xopp"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:403
msgid "fix: single element/position strokes were not rendered"
msgstr "corrección: no se renderizaban los trazos de un solo elemento/posición"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:404
msgid "fix: stop document autoexpanding when scrolling with scrollbars"
msgstr ""
"corrección: el documento ya no se expande automáticamente al desplazarse con "
"las barras de desplazamiento"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:412
msgid ""
"orga: Rnote now follows a new versioning scheme - feature updates will "
"increment x, while patches will increment y in versions 0.x.y . Breakages in "
"the file format will be explicitly announced (but we'll work as hard as "
"possible to avoid them!) and are not reflected in the version anymore."
msgstr ""
"organización: Rnote ahora sigue un nuevo esquema de versiones - las "
"actualizaciones con novedades incrementarán x, mientras que los parches "
"incrementarán y en las versiones 0.x.y . Las rupturas del formato de archivo "
"se anunciarán explícitamente (¡pero haremos todo lo posible por evitarlas!) "
"y ya no se reflejan en la versión."

#: crates/rnote-ui/data/app.metainfo.xml.in.in:414
msgid ""
"orga: the app is now available for Windows and MacOS! Check the installation "
"section on the website / README, you'll find links to the installer and app "
"bundle there."
msgstr ""
"organización: ¡la aplicación ya está disponible para Windows y macOS! "
"Consulte la sección de instalación en el sitio web / README; allí encontrará "
"enlaces al instalador y al paquete de la aplicación."

#: crates/rnote-ui/data/app.metainfo.xml.in.in:415
msgid "feature: arrow shapes (thanks to @TornaxO7 )"
msgstr "novedad: formas de flecha (gracias a @TornaxO7)"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:416
msgid "feature: ability to recolor selected strokes (thanks to @Kneemund )"
msgstr ""
"novedad: posibilidad de cambiar el color de los trazos seleccionados "
"(gracias a @Kneemund)"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:417
msgid "feature: isometric background patterns (thanks to @Kneemund )"
msgstr "novedad: patrones de fondo isométricos (gracias a @Kneemund)"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:418
msgid "feature: add option to block pinch zoom (thanks to @LeSnake04 )"
msgstr ""
"novedad: opción para bloquear el zoom con pellizco (gracias a @LeSnake04)"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:419
msgid "improvement: typewriter keyboard navigation (thanks to @Kneemund )"
msgstr ""
"mejora: navegación con el teclado en la máquina de escribir (gracias a "
"@Kneemund)"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:420
msgid "improvement: exiting / closing dialogs and logic (thanks to @adih-20 )"
msgstr "mejora: diálogos y lógica de salida / cierre (gracias a @adih-20)"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:421
msgid "improvement: more icons for workspace list entries"
msgstr "mejora: más iconos para las entradas de la lista de áreas de trabajo"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:422
msgid "improvement: associated symbolic icon for .rnote files"
msgstr "mejora: icono simbólico asociado a los archivos .rnote"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:423
msgid ""
"improvement: added labels for name and directory of the active workspace"
msgstr ""
"mejora: etiquetas para el nombre y el directorio del área de trabajo activa"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:424
msgid "fix: occasional crashes when doing three-finger swipes"
msgstr "corrección: cierres inesperados ocasionales al deslizar con tres dedos"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:425
