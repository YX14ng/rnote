msgid "this release changes:"
msgstr "此版本的變更："

#: crates/rnote-ui/data/app.metainfo.xml.in.in:95
msgid "fix: transparent stroke rendering (@Kneemund)"
msgstr "修正：透明筆畫的繪製（@Kneemund）"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:96
msgid "fix: document not staying centered after zooming (@Kneemund)"
msgstr "修正：縮放後文件未保持置中（@Kneemund）"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:97
msgid "fix: pinch zooming on touchscreen (@Kneemund)"
msgstr "修正：觸控螢幕上的雙指縮放（@Kneemund）"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:98
msgid "fix: jumping view while zooming in (@Kneemund)"
msgstr "修正：放大時畫面跳動（@Kneemund）"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:99
msgid "fix: zooming with \"alt+shift+drag\" (@Kneemund)"
msgstr "修正：使用「alt+shift+拖曳」縮放（@Kneemund）"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:107
msgid ""
"fix: fixed icon appearance and update to new, more consistent style (@flxzt)"
msgstr "修正：修正圖示外觀，並更新為更一致的新風格（@flxzt）"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:108
msgid "fix: file erroneously detected as removed after saving (@turicfr)"
msgstr "修正：儲存後檔案被誤判為已移除（@turicfr）"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:109
msgid ""
"fix: pinch-to-zoom causing scroll by applying workaround for GTK issue "
"(@RayJW)"
msgstr "修正：套用 GTK 問題的因應措施，修正雙指縮放造成畫面捲動（@RayJW）"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:110
msgid "fix: zooming with Ctrl+Scroll while Capslock is turned on (@Kneemund)"
msgstr "修正：開啟 Caps Lock 時以 Ctrl+捲動縮放（@Kneemund）"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:111
msgid "fix: grid snapping for all pattern styles (@Kneemund)"
msgstr "修正：所有紋理樣式的網格吸附（@Kneemund）"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:119
msgid "feat: apply workspace entry dialog by pressing Enter (@ternison)"
msgstr "新功能：在工作區項目對話框中按 Enter 即可套用（@ternison）"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:120
msgid "feat: add text formatting keyboard shortcuts (@ Keschler)"
msgstr "新功能：新增文字格式快捷鍵（@ Keschler）"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:121
msgid "feat: Xournal++ text import (@Doublonmousse)"
msgstr "新功能：匯入 Xournal++ 文字（@Doublonmousse）"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:122
msgid ""
"fix: PDF rendering issues by replace underlying library (from poppler to "
"hayro) (@flxzt)"
msgstr ""
"修正：更換底層程式庫（從 poppler 改為 hayro），修正 PDF 繪製問題（@flxzt）"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:123
msgid "feat: CLI create command (@DarshPareek)"
msgstr "新功能：CLI 的 create 指令（@DarshPareek）"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:124
msgid "feat: CLI thumbnail generation timeout (@flxzt)"
msgstr "新功能：CLI 產生縮圖的逾時設定（@flxzt）"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:125
msgid "feat: bundle CLI in flatpak (@flxzt)"
msgstr "新功能：Flatpak 內附 CLI（@flxzt）"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:126
msgid "feat: atomic file saving (@anesthetice)"
msgstr "新功能：原子式檔案儲存（@anesthetice）"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:127
msgid "improv: pen eraser default (@DorianRudolph)"
msgstr "改進：手寫筆橡皮端的預設行為（@DorianRudolph）"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:128
msgid ""
"improv: improve initial focus for import/export dialogs (@Doublonmousse)"
msgstr "改進：匯入／匯出對話框的初始焦點（@Doublonmousse）"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:129
msgid ""
"fix: file picker stealing focus from all opened windows (@Doublonmousse)"
msgstr "修正：檔案選擇器搶走所有已開啟視窗的焦點（@Doublonmousse）"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:130
msgid "fix: pen sounds on Windows (@Doublonmousse)"
msgstr "修正：Windows 上的筆觸音效（@Doublonmousse）"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:131
msgid ""
"fix: prevent crash when sorting files with non UTF-8 names (@Doublonmousse)"
msgstr "修正：排序名稱非 UTF-8 的檔案時當機（@Doublonmousse）"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:132
msgid "fix: rnote thumbnailer execution (@flxzt)"
msgstr "修正：rnote 縮圖產生器的執行（@flxzt）"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:133
msgid "fix: workspace directory default (@flxzt)"
msgstr "修正：工作區目錄的預設值（@flxzt）"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:141
msgid "fix: occasional PDF import failure (thanks to @Doublonmousse)"
msgstr "修正：偶發的 PDF 匯入失敗（感謝 @Doublonmousse）"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:142
msgid ""
"fix: add back accidentally removed 'Pen Style' keyboard shortcuts (thanks to "
"@Doublonmousse)"
msgstr "修正：加回誤刪的「筆樣式」快捷鍵（感謝 @Doublonmousse）"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:150
msgid "feat: save/restore engine configuration with preset"
msgstr "新功能：以預設儲存／還原引擎設定"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:151
msgid "feat: respect snap-positions option when building shapes"
msgstr "新功能：建立形狀時遵循位置吸附選項"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:152
msgid ""
"feat: shape styling options and shape highlight-mode (thanks to @anesthetice)"
msgstr "新功能：形狀樣式選項與形狀的高亮模式（感謝 @anesthetice）"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:153
msgid ""
"improv: application window always focused when opening a file (thanks to "
"@Nugfle)"
msgstr "改進：開啟檔案時應用程式視窗一律會取得焦點（感謝 @Nugfle）"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:154
msgid ""
"fix: selected part when renaming files in the application file browser "
"(thanks to @Kneemund)"
msgstr ""
"修正：在應用程式的檔案瀏覽器中重新命名檔案時選取的部分（感謝 @Kneemund）"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:155
msgid ""
"fix: cancelling import dialogs not stopping progress bar (thanks to "
"@Doublonmousse)"
msgstr "修正：取消匯入對話框後進度列不會停止（感謝 @Doublonmousse）"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:156
msgid "fix: missing translation for a string (thanks to @Doublonmousse)"
msgstr "修正：某個字串缺少翻譯（感謝 @Doublonmousse）"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:157
msgid ""
"fix: save file logic when encountering corner cases (thanks to "
"@Doublonmousse)"
msgstr "修正：遇到特殊情況時的檔案儲存邏輯（感謝 @Doublonmousse）"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:158
msgid "fix: filename sorting in integrated files list"
msgstr "修正：內建檔案清單的檔名排序"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:159
msgid "fix: prevent occasional xopp import failure"
msgstr "修正：避免偶發的 xopp 匯入失敗"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:167
msgid "feat: laser tool with animations (thanks to @Kneemund)"
msgstr "新功能：附帶動畫的雷射工具（感謝 @Kneemund）"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:168
msgid "feat: tab overviews (thanks to @zefr0x)"
msgstr "新功能：標籤頁總覽（感謝 @zefr0x）"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:169
msgid "feat: thumbnailer for .rnote files (thanks to @tiziodcaio)"
msgstr "新功能：.rnote 檔案的縮圖產生器（感謝 @tiziodcaio）"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:170
msgid ""
"feat: keyboard clipboard paste at pointer location (thanks to @Kneemund)"
msgstr "新功能：以鍵盤從剪貼簿貼上至指標位置（感謝 @Kneemund）"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:171
msgid "feat: multi-click selections (thanks to @Kneemund)"
msgstr "新功能：多次點擊選取（感謝 @Kneemund）"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:172
msgid ""
"feat: new limit movements options for vertical-space tool (thanks to "
"@Doublonmousse)"
msgstr "新功能：縱向空白工具新增限制移動的選項（感謝 @Doublonmousse）"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:173
msgid ""
"feat: confirmation prompt for file/folder trash action (thanks to @RayJW)"
msgstr "新功能：將檔案／資料夾移至回收站前會要求確認（感謝 @RayJW）"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:174
msgid "feat: open workspace folder option (thanks to @Doublonmousse)"
msgstr "新功能：開啟工作區資料夾的選項（感謝 @Doublonmousse）"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:175
msgid "feat: import of encrypted PDFs (thanks to @kq98)"
msgstr "新功能：匯入加密的 PDF（感謝 @kq98）"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:176
msgid ""
"improv: support keyboard and uncommon key shortcuts (thanks to @Kneemund)"
msgstr "改進：支援鍵盤與不常見按鍵的快捷鍵（感謝 @Kneemund）"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:177
msgid ""
"improv: clipboard pasting on certain platforms like macOS (thanks to "
"@Doublonmousse)"
msgstr "改進：在 macOS 等特定平台上從剪貼簿貼上（感謝 @Doublonmousse）"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:178
msgid "fix: selection handle sensitivity in \"single-selection\" mode"
msgstr "修正：「單一選取」模式下選取控點的靈敏度"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:179
msgid ""
"fix: unwanted activation of long-press gesture after zooming (thanks to "
"@Kneemund)"
msgstr "修正：縮放後誤觸發長按手勢（感謝 @Kneemund）"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:180
msgid "fix: allow view movement while having a selection"
msgstr "修正：有選取內容時也能移動畫面"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:181
msgid ""
"fix: cli file collision resolution in non-interactive settings (thanks to "
"@LeSnake04)"
msgstr "修正：CLI 在非互動模式下的檔案衝突處理（感謝 @LeSnake04）"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:182
msgid "fix: missing tooltips (thanks to @Doublonmousse)"
msgstr "修正：缺少的工具提示（感謝 @Doublonmousse）"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:183
msgid "fix: window shadows on Windows (thanks to @Doublonmousse)"
msgstr "修正：Windows 上的視窗陰影（感謝 @Doublonmousse）"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:184
msgid "fix: .rnote file icons in file managers"
msgstr "修正：檔案管理員中 .rnote 檔案的圖示"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:185
msgid ""
"fix: selecting colors not working properly in certain cases (thanks to "
"@Kneemund)"
msgstr "修正：某些情況下無法正常選擇顏色（感謝 @Kneemund）"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:193
msgid "feat: add disable option for pen shortcuts (thanks to @Doublonmousse)"
msgstr "新功能：新增停用筆快捷鍵的選項（感謝 @Doublonmousse）"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:194
msgid ""
"feat: add respect-borders option, improving size logic when pasting content "
"(thanks to @Doublonmousse)"
msgstr ""
"新功能：新增「遵守邊界」選項，改善貼上內容時的尺寸邏輯（感謝 @Doublonmousse）"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:195
msgid ""
"feat: add improve-for-E-Paper option, showing current selected color as a "
"string"
msgstr "新功能：新增「為電子紙最佳化」選項，以文字顯示目前選擇的顏色"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:196
msgid "improv: migrate to libadwaita based dialogs (thanks to @zefr0x)"
msgstr "改進：改用 libadwaita 對話框（感謝 @zefr0x）"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:197
msgid ""
"improv: stroke modeler entirely rewritten in Rust! (thanks to @Doublonmousse)"
msgstr "改進：筆畫模型器完全以 Rust 重寫！（感謝 @Doublonmousse）"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:198
msgid "improv: zoom tool following the pointer (thanks to @JonathanGodar)"
msgstr "改進：縮放工具會跟隨指標（感謝 @JonathanGodar）"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:199
msgid "improv: developers list in about window (thanks to @zefr0x)"
msgstr "改進：「關於」視窗中的開發者清單（感謝 @zefr0x）"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:200
msgid ""
"improv: native file dialogs on Windows, macOS (thanks to @Doublonmousse)"
msgstr "改進：Windows 與 macOS 上使用原生檔案對話框（感謝 @Doublonmousse）"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:201
msgid ""
"improv: gzip (de)compression optimizations, reducing file save/load times "
"(thanks to @anesthetice)"
msgstr ""
"改進：最佳化 gzip 壓縮與解壓縮，縮短檔案儲存與載入時間（感謝 @anesthetice）"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:202
msgid ""
"improv: prevent accidental resizes/moves when interacting with buttons in "
"the titlebar"
msgstr "改進：避免在與標題列按鈕互動時意外調整視窗大小或移動視窗"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:203
msgid "improv: inhibit app close while saves are in progress"
msgstr "改進：儲存進行中時阻止關閉應用程式"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:204
msgid ""
"improv: ability to change text selection colors inside a single text box"
msgstr "改進：可在單一文字方塊內變更所選文字的顏色"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:205
msgid "fix: pen state becoming incorrect on windows (thanks to @Doublonmousse)"
msgstr "修正：Windows 上筆的狀態出錯（感謝 @Doublonmousse）"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:206
msgid "fix: file extension filters in dialogs (thanks to @Doublonmousse)"
msgstr "修正：對話框中的副檔名篩選（感謝 @Doublonmousse）"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:207
msgid ""
"fix: force the gtk renderer to gl for now, fixing recurring crashes for some "
"users (thanks to @Doublonmousse)"
msgstr ""
"修正：暫時強制 GTK 繪製器使用 GL，修正部分使用者反覆當機的問題（感謝 "
"@Doublonmousse）"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:208
msgid "fix: two-finger long-press gesture causing crashes for some users"
msgstr "修正：雙指長按手勢導致部分使用者當機"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:209
msgid "fix: single element stroke not generating hitboxes"
msgstr "修正：單一元素的筆畫不會產生碰撞框"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:210
msgid ""
"fix: scrolls being captured by unit-entries in settings, causing accidental "
"value changes"
msgstr "修正：設定中的單位輸入框會攔截捲動，導致數值被意外變更"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:211
msgid "fix: hover state for typewriter move/resize nodes"
msgstr "修正：文字工具移動／調整大小控點的懸停狀態"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:219
msgid ""
"improv: put handles outside of selection borders, enable resizing to smaller "
"sizes (thanks to @Doublonmousse)"
msgstr "改進：控點移到選取框外側，並可縮放到更小的尺寸（感謝 @Doublonmousse）"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:220
msgid ""
"improv: error notification when file operations fail in workspace browser"
msgstr "改進：工作區瀏覽器中的檔案操作失敗時會顯示錯誤通知"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:221
msgid "metainfo: add brand colors (thanks to @bertob)"
msgstr "metainfo：新增品牌色（感謝 @bertob）"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:222
msgid "fix: origin indicator cross size on hi-dpi screens"
msgstr "修正：高 DPI 螢幕上原點指示十字的大小"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:223
msgid "fix: rendering got out of sync when resizing long-to-render content"
msgstr "修正：調整需要長時間繪製的內容大小時，繪製結果不同步"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:224
msgid "fix: selection stroke widths got larger when resizing non-uniformly"
msgstr "修正：非等比例縮放時，選取內容的筆畫寬度變大"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:225
msgid ""
"fix: regression which caused excessive rerendering of selection during "
"resizing"
msgstr "修正：調整大小時選取內容過度重新繪製的回歸問題"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:233
msgid ""
"fix: importing images changed document dimensions when `adjust-document` pdf "
"import setting is set"
msgstr "修正：設定「adjust-document」PDF 匯入選項時，匯入圖片會改變文件尺寸"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:234
msgid ""
"fix: windows installer now includes EGL/GLES libraries, fixing launch error "
"when they are present elsewhere but in PATH"
msgstr ""
"修正：Windows 安裝程式現在包含 EGL/GLES 程式庫，修正 PATH 中其他位置也有這些"
"程式庫時的啟動錯誤"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:242
msgid "feat: touch-hold context-menu with basic actions (thanks to @silvasch)"
msgstr "新功能：觸控長按的內容選單，提供基本動作（感謝 @silvasch）"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:243
msgid "feat: added polygon shape and builder"
msgstr "新功能：新增多邊形形狀及其建構工具"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:244
msgid ""
"feat: added adjust-document Pdf import option that configures the document "
"for improved annotation use-case"
msgstr "新功能：新增「adjust-document」PDF 匯入選項，調整文件設定以便於註解"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:245
msgid "improv: additional color button (default: white) (thanks to @silvasch)"
msgstr "改進：額外的顏色按鈕（預設為白色）（感謝 @silvasch）"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:246
msgid ""
"improv: new keyboard shortcuts for managing windows and tabs (thanks to "
"@silvasch)"
msgstr "改進：用於管理視窗與標籤頁的新快捷鍵（感謝 @silvasch）"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:247
msgid ""
"improv: autosave all tabs, but only ones that are flagged modified (thanks "
"to @Doublonmousse)"
msgstr ""
"改進：自動儲存所有標籤頁，但只儲存標記為已修改的（感謝 @Doublonmousse）"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:248
msgid ""
"improv: don't export empty layers when exporting to xopp (thanks to "
"@Doublonmousse)"
msgstr "改進：匯出為 xopp 時不匯出空白圖層（感謝 @Doublonmousse）"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:249
msgid ""
"improv: workspace browser is now separated into three sections: folders - "
"rnote notes - other importable files"
msgstr ""
"改進：工作區瀏覽器現在分為三個區段：資料夾、rnote 筆記、其他可匯入的檔案"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:250
msgid "improv: use start aspect ratio when resizing and locking aspect-ratio"
msgstr "改進：調整大小並鎖定長寬比時，使用開始時的長寬比"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:251
msgid ""
"improv: renaming file in workspace browser selects only file stem initially"
msgstr "改進：在工作區瀏覽器中重新命名檔案時，一開始只選取主檔名"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:252
msgid "improv: move document-layout option from canvas-menu to settings"
msgstr "改進：將文件佈局選項從畫布選單移至設定"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:253
msgid ""
"improv: reduce repaints - when stroke is finished, cache origin-indicator "
"rendering"
msgstr "改進：減少重繪——筆畫完成後快取原點指示器的繪製結果"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:254
msgid "improv: added new-window menu entry"
msgstr "改進：新增「新視窗」選單項目"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:255
msgid ""
"improv: file watcher implementation and rnote file writing, possibly fixing "
"\"reload document\" toasts when file is saved on windows"
msgstr ""
"改進：檔案監看的實作與 rnote 檔案寫入，可能修正在 Windows 上儲存檔案時出現"
"「重新載入文件」通知的問題"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:256
msgid ""
"fix: failing export/clipboard-copy with large images (thanks to "
"@Doublonmousse)"
msgstr "修正：大型圖片匯出或複製到剪貼簿失敗（感謝 @Doublonmousse）"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:257
msgid ""
"fix: menus positions when opened through keyboard shortcut (thanks to "
"@detiam)"
msgstr "修正：透過快捷鍵開啟選單時的位置（感謝 @detiam）"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:258
msgid "fix: zoom label not being updated after switching tab"
msgstr "修正：切換標籤頁後縮放比例未更新"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:259
msgid "fix: regression where margin is not applied when exporting selection"
msgstr "修正：匯出選取內容時未套用邊距的回歸問題"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:260
msgid "fix: undo/redo triggering document-modified flag"
msgstr "修正：復原／重做會觸發「文件已修改」標記"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:268
msgid ""
"ux: increase window threshold width at where the sidebar becomes an overlay"
msgstr "使用體驗：加大側邊欄變為浮層時的視窗寬度門檻"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:269
msgid ""
"fix: indicate unsaved when changing document settings (format, colors, "
"pattern, ..)"
msgstr "修正：變更文件設定（格式、顏色、紋理等）時標示為未儲存"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:270
msgid "fix: missing progress pulse when saving existing doc"
msgstr "修正：儲存現有文件時缺少進度指示"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:271
msgid "fix: ui not being refreshed after loading document from file"
msgstr "修正：從檔案載入文件後介面未重新整理"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:272
msgid "fix: jumping view when zoomed out and reaching edges"
msgstr "修正：縮小並到達邊緣時畫面跳動"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:280
msgid ""
"improvement: add button to export notification to open file location in file-"
"manager after exporting (thanks to @silvasch)"
msgstr ""
"改進：匯出通知新增按鈕，匯出後可在檔案管理員中開啟檔案位置（感謝 @silvasch）"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:281
msgid ""
"improvement: initial export file picker folder got improved, now "
"prioritising the rnote file location and are now remembered between exports "
"(thanks to @pobrn )"
msgstr ""
"改進：改善匯出檔案選擇器的初始資料夾，現在優先使用 rnote 檔案的位置，並會在多"
"次匯出之間記住（感謝 @pobrn）"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:282
msgid "improvement: more readable file row names"
msgstr "改進：檔案列的名稱更易讀"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:283
msgid "improvement: add keyboard shortcut for snap-positions action"
msgstr "改進：為位置吸附動作新增快捷鍵"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:284
msgid "improvement: pdf import option to toggle page borders"
msgstr "改進：PDF 匯入選項可切換頁面邊框"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:285
msgid ""
"fix: don't export empty pages that are adjacent to content that is snapped "
"to the document grid"
msgstr "修正：不匯出與吸附到文件網格的內容相鄰的空白頁"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:286
msgid ""
"fix: progress pulses getting out of sync when executing multiple operations "
"in parallel"
msgstr "修正：同時執行多個操作時進度指示不同步"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:287
msgid ""
"fix: typewriter width adjustment button disappearing after setting it to "
"minimal width"
msgstr "修正：文字工具的寬度調整按鈕在設為最小寬度後消失"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:295
msgid ""
"feature: option to snap positions in different tools to pattern and document "
"grid"
msgstr "新功能：可讓不同工具的位置吸附到紋理與文件網格"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:296
msgid ""
"feature: option to open files with default app from workspace browser list "
"(thanks to @silvasch)"
msgstr "新功能：可從工作區瀏覽器清單以預設應用程式開啟檔案（感謝 @silvasch）"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:297
msgid ""
"improvement: sort workspace files and folders in a more intuitive way "
"(thanks to @doublonmousse)"
msgstr "改進：以更直覺的方式排序工作區的檔案與資料夾（感謝 @doublonmousse）"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:298
msgid ""
"fix: initial documents opened with rnote have blurry rendering when system "
"scale-factor is larger than 1.0"
msgstr "修正：系統縮放比例大於 1.0 時，以 rnote 開啟的初始文件繪製模糊"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:299
msgid ""
"fix: selection after nudging view only included strokes in current viewport"
msgstr "修正：輕推畫面後的選取只包含目前可視區域內的筆畫"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:300
msgid "fix: text files not appearing in workspacebrowser"
msgstr "修正：文字檔未顯示在工作區瀏覽器中"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:308
msgid ""
"feature: ability to toggle the visibility of the origin indicator cross "
"(thanks to @silvasch)"
msgstr "新功能：可切換原點指示十字的顯示（感謝 @silvasch）"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:309
msgid ""
"improvement: port rows widgets to libadwaita spezialized variants (thanks to "
"@oscfdezdz)"
msgstr "改進：將列元件移植為 libadwaita 的專用變體（感謝 @oscfdezdz）"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:310
msgid ""
"improvement: text formatting buttons now toggle text attributes (thanks to "
"@xweskingx)"
msgstr "改進：文字格式按鈕現在可切換文字屬性（感謝 @xweskingx）"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:311
msgid ""
"improvement: load documents into the current tab if it is a draft and empty "
"(thanks to @silvasch)"
msgstr ""
"改進：若目前的標籤頁是空白草稿，就把文件載入到該標籤頁（感謝 @silvasch）"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:312
msgid "UI: tweak sidebar width"
msgstr "介面：調整側邊欄寬度"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:313
msgid ""
"fix: don't display reload-file dialog after saving to directories synced "
"with cloud storage"
msgstr "修正：儲存到與雲端儲存空間同步的目錄後，不再顯示重新載入檔案的對話框"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:314
msgid "fix: chinese translations (thanks to @detiam)"
msgstr "修正：中文翻譯（感謝 @detiam）"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:315
msgid "fix: single position strokes not being rendered"
msgstr "修正：單一位置的筆畫未被繪製"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:316
msgid ""
"fix: don't restore maximized window state on macos, fixing inability to "
"resize the window after launch"
msgstr ""
"修正：在 macOS 上不還原最大化的視窗狀態，修正啟動後無法調整視窗大小的問題"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:317
msgid ""
"fix: windows installer not including certain dll's, possibly causing crashes "
"when the missing ones are located elsewhere and present in PATH (thanks to "
"@mdonoughe)"
msgstr ""
"修正：Windows 安裝程式未包含部分 DLL，當缺少的 DLL 位於其他位置且在 PATH 中時"
"可能導致當機（感謝 @mdonoughe）"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:325
msgid "feature: added ctrl plus space as configurable shortcut"
msgstr "新功能：新增可自訂的 Ctrl + 空白鍵快捷鍵"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:326
msgid "feature: added plaintext file import"
msgstr "新功能：新增純文字檔案匯入"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:327
msgid "feature: ability to nudge view while performing certain pen actions"
msgstr "新功能：執行特定筆動作時可輕推畫面"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:328
msgid ""
"improvement: port the UI to libadwaita 1.4 with an improved sidebar and "
"adaptivity"
msgstr "改進：介面移植到 libadwaita 1.4，改善側邊欄與自適應版面"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:329
msgid ""
"improvement: scale widths of brush-strokes and shapes when resizing selection"
msgstr "改進：調整選取內容大小時，一併縮放筆刷筆畫與形狀的寬度"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:330
msgid ""
"improvement: added keyboard shortcuts to add/remove pages when in fixed-size "
"layout"
msgstr "改進：新增在固定大小佈局中新增／移除頁面的快捷鍵"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:331
msgid ""
"improvement: the current document view is saved and restored to/from rnote "
"files"
msgstr "改進：目前的文件檢視會儲存到 rnote 檔案，並從中還原"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:332
msgid ""
"improvement: orientation toggle usable when using custom document dimensions"
msgstr "改進：使用自訂文件尺寸時也能切換方向"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:333
msgid ""
"improvement: shape builder picker sidebar location (thanks to @PhilDevProg)"
msgstr "改進：形狀建構工具選擇器在側邊欄中的位置（感謝 @PhilDevProg）"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:334
msgid ""
"fix: when using the vertical-space tool strokes that came into view were not "
"initially rendered"
msgstr "修正：使用縱向空白工具時，進入畫面的筆畫一開始未被繪製"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:335
msgid "fix: color picker dialog could be opened multiple times"
msgstr "修正：顏色選擇器對話框可被重複開啟"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:336
msgid "fix: default view offset when opening a new tab"
msgstr "修正：開啟新標籤頁時的預設檢視偏移"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:344
msgid "fix: button presses not handled as pen events"
msgstr "修正：按鈕按壓未被當作筆事件處理"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:345
msgid "fix: windows build"
msgstr "修正：Windows 版建置"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:346
msgid "fix: bundled fonts not appearing in flatpak"
msgstr "修正：內附字型未出現在 Flatpak 中"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:354
msgid "feature: export previews"
msgstr "新功能：匯出預覽"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:355
msgid "feature: invert selection color brightness (thanks to @Kneemund)"
msgstr "新功能：反轉選取內容的顏色亮度（感謝 @Kneemund）"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:356
msgid "feature: optimize for printing export option (thanks to @Kneemund)"
msgstr "新功能：「為列印最佳化」匯出選項（感謝 @Kneemund）"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:357
msgid ""
"feature: a few handwrite-y,typewriter and dyslexia fonts are now bundled "
"with the application (check the README for a list of them)"
msgstr ""
"新功能：應用程式現在內附一些手寫風、打字機風與適合閱讀障礙者的字型（清單請見 "
"README）"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:358
msgid "feature: polyline shape and builder"
msgstr "新功能：多段線形狀及其建構工具"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:359
msgid "improvement: cli export enhancements (thanks to @LeSnake04)"
msgstr "改進：CLI 匯出功能強化（感謝 @LeSnake04）"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:360
msgid "improvement: update outdated symbolic icons (thanks to @oscfdezdz)"
msgstr "改進：更新過時的符號圖示（感謝 @oscfdezdz）"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:361
msgid "improvement: behaviour when opening files in new tab"
msgstr "改進：在新標籤頁中開啟檔案時的行為"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:362
msgid ""
"improvement: added close buttons to configuration popovers as a workaround "
"for the Gtk4 stuck-popover bug"
msgstr ""
"改進：在設定彈出視窗中加入關閉按鈕，作為 GTK4 彈出視窗卡住問題的因應措施"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:363
msgid "improvement: default view offset when opening documents"
msgstr "改進：開啟文件時的預設檢視偏移"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:364
msgid "enhancement: move view using arrow keys"
msgstr "增強：可用方向鍵移動畫面"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:365
msgid "fix: orientation of some popovers when sidebar is on the left"
msgstr "修正：側邊欄位於左側時部分彈出視窗的方向"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:366
msgid "fix: restore vectorized images (Pdf pages, Svg) export"
msgstr "修正：恢復向量圖片（PDF 頁面、SVG）的匯出"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:367
msgid "fix: .rnote file imports that were created pre v0.5.9"
msgstr "修正：匯入 v0.5.9 之前建立的 .rnote 檔案"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:368
msgid "fix: rendering of closed shapes from imported xopp file"
msgstr "修正：繪製從 xopp 檔案匯入的封閉形狀"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:376
msgid "improvement: more consistent duplicate file naming"
msgstr "改進：重複檔案的命名更一致"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:377
msgid "UI: more compact sidebar, shape-picker, workspacebrowser"
msgstr "介面：更精簡的側邊欄、形狀選擇器與工作區瀏覽器"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:378
msgid ""
"fix: import dialogs were not shown when importing files or drag-and-drop "
"from file-managers (thanks to @Kneemund)"
msgstr "修正：匯入檔案或從檔案管理員拖放時未顯示匯入對話框（感謝 @Kneemund）"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:386
msgid ""
"installation: windows users - the installer now uses 64-bit mode, and now "
"(correctly) installs into \"Program Files\" by default. If you are upgrading "
"from a previous version, you need to uninstall the old version in \"Program "
"Files (x86)\" manually."
msgstr ""
"安裝：Windows 使用者請注意——安裝程式現在使用 64 位元模式，並（正確地）預設安"
"裝到「Program Files」。若從舊版升級，需要手動解除安裝位於「Program Files "
"(x86)」的舊版本。"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:388
msgid "feature: remove page from fixed size document (thanks to @PhilDevProg)"
msgstr "新功能：從固定大小的文件中移除頁面（感謝 @PhilDevProg）"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:389
msgid ""
"feature: specify page order when exporting documents with layouts that "
"expand in horizontal and vertical directions (thanks to @Kneemund)"
msgstr ""
"新功能：匯出佈局會向水平與垂直方向延伸的文件時，可指定頁面順序（感謝 "
"@Kneemund）"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:390
msgid "feature: inertial touch scrolling (thanks to @Kneemund)"
msgstr "新功能：觸控慣性捲動（感謝 @Kneemund）"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:391
msgid "feature: ability to toggle drawing cursor visibility"
msgstr "新功能：可切換畫筆游標的顯示"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:392
msgid ""
"feature: \"focus mode\" that hides the toolbars, improving the experience on "
"low-resolution tablets"
msgstr "新功能：隱藏工具列的「專注模式」，改善在低解析度平板上的體驗"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:393
msgid ""
"feature: dedicated zoom tool, making navigating while touch-drawing is "
"enabled easier"
msgstr "新功能：專用的縮放工具，啟用觸控繪圖時更容易瀏覽"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:394
msgid "improvement: selection highlights for brush-strokes"
msgstr "改進：筆刷筆畫的選取高亮"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:395
msgid "improvement: ctrl + scroll following the pointer"
msgstr "改進：Ctrl + 捲動時會跟隨指標"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:396
msgid ""
"improvement: scale-ratio when resizing the selection with locked aspect-ratio"
msgstr "改進：鎖定長寬比時調整選取內容大小的縮放比例"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:397
msgid ""
"improvement: provide selection content as Svg and Png when copying/cutting "
"to the clipboard"
msgstr "改進：複製／剪下到剪貼簿時，以 SVG 與 PNG 提供選取內容"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:398
msgid "improvement: save file logic in close tab/window dialogs"
msgstr "改進：關閉標籤頁／視窗對話框中的檔案儲存邏輯"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:399
msgid "improvement: memory consumption when loading rnote files"
msgstr "改進：載入 rnote 檔案時的記憶體用量"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:400
msgid ""
"UI: page controls for the fixed-size layout were moved into the canvas menu "
"dropdown"
msgstr "介面：固定大小佈局的頁面控制項已移至畫布選單的下拉清單"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:401
msgid "UI: undo/redo buttons were moved to the pen switcher toolbar"
msgstr "介面：復原／重做按鈕已移至筆切換工具列"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:402
msgid "fix: apply pressure curves when exporting to xopp"
msgstr "修正：匯出為 xopp 時套用壓力曲線"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:403
msgid "fix: single element/position strokes were not rendered"
msgstr "修正：單一元素／位置的筆畫未被繪製"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:404
msgid "fix: stop document autoexpanding when scrolling with scrollbars"
msgstr "修正：使用捲軸捲動時，文件不再自動擴展"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:412
msgid ""
"orga: Rnote now follows a new versioning scheme - feature updates will "
"increment x, while patches will increment y in versions 0.x.y . Breakages in "
"the file format will be explicitly announced (but we'll work as hard as "
"possible to avoid them!) and are not reflected in the version anymore."
msgstr ""
"組織：Rnote 現在採用新的版本編號方式——功能更新會遞增 0.x.y 版本中的 x，修補程"
"式則遞增 y。檔案格式的不相容變更將會明確公告（但我們會盡全力避免！），且不再"
"反映在版本號中。"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:414
msgid ""
"orga: the app is now available for Windows and MacOS! Check the installation "
"section on the website / README, you'll find links to the installer and app "
"bundle there."
msgstr ""
"組織：本應用程式現已推出 Windows 與 macOS 版本！請查看網站或 README 的安裝章"
"節，那裡有安裝程式與應用程式套件的連結。"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:415
msgid "feature: arrow shapes (thanks to @TornaxO7 )"
msgstr "新功能：箭頭形狀（感謝 @TornaxO7）"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:416
msgid "feature: ability to recolor selected strokes (thanks to @Kneemund )"
msgstr "新功能：可為選取的筆畫重新上色（感謝 @Kneemund）"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:417
msgid "feature: isometric background patterns (thanks to @Kneemund )"
msgstr "新功能：等距背景紋理（感謝 @Kneemund）"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:418
msgid "feature: add option to block pinch zoom (thanks to @LeSnake04 )"
msgstr "新功能：新增停用雙指縮放的選項（感謝 @LeSnake04）"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:419
msgid "improvement: typewriter keyboard navigation (thanks to @Kneemund )"
msgstr "改進：文字工具的鍵盤導覽（感謝 @Kneemund）"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:420
msgid "improvement: exiting / closing dialogs and logic (thanks to @adih-20 )"
msgstr "改進：結束／關閉對話框及其邏輯（感謝 @adih-20）"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:421
msgid "improvement: more icons for workspace list entries"
msgstr "改進：工作區清單項目有更多圖示"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:422
msgid "improvement: associated symbolic icon for .rnote files"
msgstr "改進：.rnote 檔案的對應符號圖示"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:423
msgid ""
"improvement: added labels for name and directory of the active workspace"
msgstr "改進：新增目前工作區名稱與目錄的標籤"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:424
msgid "fix: occasional crashes when doing three-finger swipes"
msgstr "修正：三指滑動時偶發的當機"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:425
msgid ""
"fix: size limits for grid builder, preventing slowdowns and crashes (thanks "
"to @Kneemund)"
msgstr "修正：網格建構工具的尺寸上限，避免變慢與當機（感謝 @Kneemund）"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:426
msgid ""
"fix: strokes not generating hitboxes when pen is being changed mid-stroke"
msgstr "修正：筆畫進行中切換筆時，筆畫不會產生碰撞框"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:427
msgid "fix: limit chars for dirs in edit-workspace dialog"
msgstr "修正：限制編輯工作區對話框中目錄的字元數"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:435
msgid ""
"fix: panic on app start when color scheme setting is set to \"Use Light "
"Colors\" / \"Use Dark Colors\""
msgstr "修正：配色設定為「使用淺色」／「使用深色」時，應用程式一啟動就崩潰"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:443
msgid "fix: some users experienced zip-zapping while using stylus"
msgstr "修正：部分使用者使用手寫筆時筆跡來回跳動"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:444
msgid "fix: sporadic jumps when view is near document edge"
msgstr "修正：畫面靠近文件邊緣時偶發的跳動"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:445
msgid "fix: regression where redo button stays insensitive"
msgstr "修正：重做按鈕一直無法使用的回歸問題"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:453
msgid "fix: vector export when bounds are not origin aligned"
msgstr "修正：邊界未對齊原點時的向量匯出"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:461
msgid "feature: configurable shortcuts for drawing pad buttons"
msgstr "新功能：可自訂畫板按鈕的快捷鍵"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:462
msgid ""
"improvement: input events for rate-limited devices (E-Paper/ low-frequency "
"displays)"
msgstr "改進：受限更新率裝置（電子紙／低更新率螢幕）的輸入事件"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:463
msgid "improvement: reduced Svg export size"
msgstr "改進：縮小 SVG 匯出大小"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:464
msgid "fix: artifacts when printing"
msgstr "修正：列印時的瑕疵"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:465
msgid "fix: Jpeg images embedded in Pdfs were not rendered"
msgstr "修正：PDF 中內嵌的 JPEG 圖片未被繪製"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:466
msgid "fix: select-all with \"ctrl+a\" included trashed strokes"
msgstr "修正：以「ctrl+a」全選時包含已刪除的筆畫"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:467
msgid "fix: units in settings kept resetting to \"Px\""
msgstr "修正：設定中的單位一直被重設為「Px」"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:468
msgid "fix: flicker when duplicating large selections"
msgstr "修正：複製大量選取內容時閃爍"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:476
msgid "feature: toggle mode for shortcuts"
msgstr "新功能：快捷鍵的切換模式"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:477
msgid "feature: eraser size picker"
msgstr "新功能：橡皮大小選擇器"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:478
msgid "improvement: reduce toolbar overlays margins when scrollbar is disabled"
msgstr "改進：停用捲軸時縮小工具列浮層的邊距"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:479
msgid "improvement: indicate hover over nodes in the selector and typewriter"
msgstr "改進：在選擇工具與文字工具中，懸停於控點時會有提示"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:480
msgid "improvement: reduced save and xopp export file sizes"
msgstr "改進：縮小儲存檔案與 xopp 匯出檔案的大小"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:481
msgid ""
"UI: follow Gnome HIG writing style more closely and fixed string "
"inconsistencies"
msgstr "介面：更貼近 GNOME HIG 的寫作風格，並修正字串不一致"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:482
msgid "fix: Pdf import with different size pages"
msgstr "修正：匯入頁面大小不一的 PDF"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:483
msgid ""
"fix: image and Pdf import offsets now take the document bounds into account"
msgstr "修正：圖片與 PDF 匯入的偏移現在會考量文件邊界"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:484
msgid "fix: broken resizing in fixed-size document layout"
msgstr "修正：固定大小文件佈局中無法正常調整大小"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:485
msgid "fix: crash when navigating up/down into non-ASCII text"
msgstr "修正：上下移動至非 ASCII 文字時當機"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:486
msgid "fix: crash on launch when using a custom stylesheet"
msgstr "修正：使用自訂樣式表時一啟動就當機"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:487
msgid "fix: rough style fill calculations"
msgstr "修正：粗糙樣式的填充計算"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:495
msgid "feature: tabs!"
msgstr "新功能：標籤頁！"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:496
msgid "feature: a global colorpicker"
msgstr "新功能：全域顏色選擇器"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:497
msgid "feature: stroke width preset palette"
msgstr "新功能：筆畫寬度預設調色盤"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:498
msgid "feature: added \"semi-infinite\" canvas layout ( thanks @D0V4HKIIN !)"
msgstr "新功能：新增「半無限」畫布佈局（感謝 @D0V4HKIIN！）"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:499
msgid ""
"feature: added two-finger long-press touch gesture that switches the active "
"pen (like stylus buttons)"
msgstr "新功能：新增雙指長按觸控手勢，可切換目前的筆（類似手寫筆按鈕）"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:500
msgid "feature: added pdf import bitmap scaling preference"
msgstr "新功能：新增 PDF 匯入點陣圖縮放偏好設定"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:501
msgid "UI: floating toolbars"
msgstr "介面：浮動工具列"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:502
msgid ""
"UI: shape builder picker is now a categorized grid (thanks a lot @Kneemund !)"
msgstr "介面：形狀建構工具選擇器現在是分類網格（非常感謝 @Kneemund！）"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:503
msgid "improvement: copy, cut and paste selections between tabs and windows"
msgstr "改進：在標籤頁與視窗之間複製、剪下及貼上選取內容"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:504
msgid "improvement: flap revealed state is now remembered across app launches"
msgstr "改進：側邊欄的展開狀態現在會在下次啟動時保留"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:505
msgid "fix: svg clipboard paste"
msgstr "修正：從剪貼簿貼上 SVG"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:506
msgid "fix: lag when panning in \"continuous-vertical\" layout"
msgstr "修正：在「縱向連續」佈局中平移時延遲"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:507
msgid "fix: layers when erasing marker strokes in \"split-stroke\" mode"
msgstr "修正：在「分割筆畫」模式下擦除記號筆筆畫時的圖層"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:508
msgid "fix: \"split-stroke\" mode only eraser one segment at a time"
msgstr "修正：「分割筆畫」模式一次只擦除一段"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:509
msgid "fix: freeze when saving multiple times in succession"
msgstr "修正：連續多次儲存時凍結"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:510
msgid "fix: blurry vector images after zooming in"
msgstr "修正：放大後向量圖片模糊"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:511
msgid "fix: some blurry icons"
msgstr "修正：部分圖示模糊"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:519
msgid "UI: minor sidebar tweaks"
msgstr "介面：側邊欄小幅調整"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:520
msgid "i18n: updated strings and translations"
msgstr "國際化：更新字串與翻譯"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:521
msgid "fix: remove selection bounds margins"
msgstr "修正：移除選取範圍邊界的邊距"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:522
msgid ""
"fix: don't overwrite active palette color when start modifying existing text"
msgstr "修正：開始編輯既有文字時，不覆寫調色盤中目前使用的顏色"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:530
msgid "feature: added a grid builder"
msgstr "新功能：新增網格建構工具"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:531
msgid ""
"feature: ctrl + pointer drag for panning the canvas, ctrl+shift + pointer "
"drag for zooming"
msgstr "新功能：Ctrl + 指標拖曳以平移畫布，Ctrl+Shift + 指標拖曳以縮放"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:533
msgid "improvement: added the ability to reorder workspaces"
msgstr "改進：可重新排列工作區"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:534
msgid "improvement: rough style now supports transparent colors"
msgstr "改進：粗糙樣式現在支援透明色"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:535
msgid "improvement: full asynchronicity for all import and exports"
msgstr "改進：所有匯入與匯出完全非同步"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:536
msgid "fix: rough style bezier curves drawing"
msgstr "修正：粗糙樣式的貝茲曲線繪製"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:537
msgid "fix: added missing association for `.xopp` files"
msgstr "修正：新增缺少的 `.xopp` 檔案關聯"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:538
