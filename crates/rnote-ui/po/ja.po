msgid "this release changes:"
msgstr "このリリースでの変更点:"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:95
msgid "fix: transparent stroke rendering (@Kneemund)"
msgstr "修正: 透明なストロークの描画 (@Kneemund)"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:96
msgid "fix: document not staying centered after zooming (@Kneemund)"
msgstr "修正: 拡大・縮小後に文書が中央に留まらない問題 (@Kneemund)"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:97
msgid "fix: pinch zooming on touchscreen (@Kneemund)"
msgstr "修正: タッチスクリーンでのピンチ操作による拡大・縮小 (@Kneemund)"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:98
msgid "fix: jumping view while zooming in (@Kneemund)"
msgstr "修正: 拡大中に表示が飛ぶ問題 (@Kneemund)"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:99
msgid "fix: zooming with \"alt+shift+drag\" (@Kneemund)"
msgstr "修正: 「Alt+Shift+ドラッグ」での拡大・縮小 (@Kneemund)"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:107
msgid ""
"fix: fixed icon appearance and update to new, more consistent style (@flxzt)"
msgstr ""
"修正: アイコンの表示を修正し、より統一感のある新しいスタイルに更新 (@flxzt)"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:108
msgid "fix: file erroneously detected as removed after saving (@turicfr)"
msgstr "修正: 保存後にファイルが削除されたと誤って検出される問題 (@turicfr)"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:109
msgid ""
"fix: pinch-to-zoom causing scroll by applying workaround for GTK issue "
"(@RayJW)"
msgstr ""
"修正: ピンチ操作による拡大・縮小でスクロールしてしまう問題に GTK の不具合への"
"回避策を適用 (@RayJW)"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:110
msgid "fix: zooming with Ctrl+Scroll while Capslock is turned on (@Kneemund)"
msgstr ""
"修正: Caps Lock がオンのときの Ctrl+スクロールでの拡大・縮小 (@Kneemund)"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:111
msgid "fix: grid snapping for all pattern styles (@Kneemund)"
msgstr "修正: すべての罫線スタイルでのグリッドへのスナップ (@Kneemund)"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:119
msgid "feat: apply workspace entry dialog by pressing Enter (@ternison)"
msgstr "新機能: ワークスペースの編集ダイアログを Enter キーで適用 (@ternison)"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:120
msgid "feat: add text formatting keyboard shortcuts (@ Keschler)"
msgstr ""
"新機能: テキストの書式設定用キーボードショートカットを追加 (@ Keschler)"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:121
msgid "feat: Xournal++ text import (@Doublonmousse)"
msgstr "新機能: Xournal++ のテキストのインポート (@Doublonmousse)"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:122
msgid ""
"fix: PDF rendering issues by replace underlying library (from poppler to "
"hayro) (@flxzt)"
msgstr ""
"修正: 内部ライブラリを poppler から hayro に置き換え、PDF の描画の問題を解消 "
"(@flxzt)"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:123
msgid "feat: CLI create command (@DarshPareek)"
msgstr "新機能: CLI の create コマンド (@DarshPareek)"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:124
msgid "feat: CLI thumbnail generation timeout (@flxzt)"
msgstr "新機能: CLI でのサムネイル生成のタイムアウト (@flxzt)"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:125
msgid "feat: bundle CLI in flatpak (@flxzt)"
msgstr "新機能: Flatpak に CLI を同梱 (@flxzt)"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:126
msgid "feat: atomic file saving (@anesthetice)"
msgstr "新機能: アトミックなファイル保存 (@anesthetice)"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:127
msgid "improv: pen eraser default (@DorianRudolph)"
msgstr "改善: ペンの消しゴムの既定値 (@DorianRudolph)"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:128
msgid ""
"improv: improve initial focus for import/export dialogs (@Doublonmousse)"
msgstr ""
"改善: インポート/エクスポートダイアログの初期フォーカスを改善 "
"(@Doublonmousse)"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:129
msgid ""
"fix: file picker stealing focus from all opened windows (@Doublonmousse)"
msgstr ""
"修正: ファイル選択ダイアログが開いているすべてのウィンドウからフォーカスを奪"
"う問題 (@Doublonmousse)"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:130
msgid "fix: pen sounds on Windows (@Doublonmousse)"
msgstr "修正: Windows でのペンの音 (@Doublonmousse)"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:131
msgid ""
"fix: prevent crash when sorting files with non UTF-8 names (@Doublonmousse)"
msgstr ""
"修正: UTF-8 以外の名前のファイルを並べ替えるとクラッシュする問題を防止 "
"(@Doublonmousse)"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:132
msgid "fix: rnote thumbnailer execution (@flxzt)"
msgstr "修正: Rnote のサムネイル生成プログラムの実行 (@flxzt)"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:133
msgid "fix: workspace directory default (@flxzt)"
msgstr "修正: ワークスペースディレクトリの既定値 (@flxzt)"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:141
msgid "fix: occasional PDF import failure (thanks to @Doublonmousse)"
msgstr ""
"修正: PDF のインポートがときどき失敗する問題 (@Doublonmousse さんに感謝)"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:142
msgid ""
"fix: add back accidentally removed 'Pen Style' keyboard shortcuts (thanks to "
"@Doublonmousse)"
msgstr ""
"修正: 誤って削除されていた「ペンのスタイル」のキーボードショートカットを復活 "
"(@Doublonmousse さんに感謝)"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:150
msgid "feat: save/restore engine configuration with preset"
msgstr "新機能: エンジンの設定をプリセットとして保存/復元"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:151
msgid "feat: respect snap-positions option when building shapes"
msgstr "新機能: 図形の作成時に「位置をスナップ」の設定を反映"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:152
msgid ""
"feat: shape styling options and shape highlight-mode (thanks to @anesthetice)"
msgstr "新機能: 図形のスタイル設定とハイライトモード (@anesthetice さんに感謝)"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:153
msgid ""
"improv: application window always focused when opening a file (thanks to "
"@Nugfle)"
msgstr ""
"改善: ファイルを開くと常にアプリケーションのウィンドウにフォーカス (@Nugfle "
"さんに感謝)"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:154
msgid ""
"fix: selected part when renaming files in the application file browser "
"(thanks to @Kneemund)"
msgstr ""
"修正: アプリ内のファイルブラウザーでファイル名を変更する際に選択される部分 "
"(@Kneemund さんに感謝)"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:155
msgid ""
"fix: cancelling import dialogs not stopping progress bar (thanks to "
"@Doublonmousse)"
msgstr ""
"修正: インポートダイアログをキャンセルしても進行状況バーが止まらない問題 "
"(@Doublonmousse さんに感謝)"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:156
msgid "fix: missing translation for a string (thanks to @Doublonmousse)"
msgstr "修正: 翻訳されていなかった文字列 (@Doublonmousse さんに感謝)"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:157
msgid ""
"fix: save file logic when encountering corner cases (thanks to "
"@Doublonmousse)"
msgstr "修正: 特殊なケースでのファイル保存の処理 (@Doublonmousse さんに感謝)"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:158
msgid "fix: filename sorting in integrated files list"
msgstr "修正: 内蔵のファイル一覧でのファイル名の並べ替え"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:159
msgid "fix: prevent occasional xopp import failure"
msgstr "修正: Xopp のインポートがときどき失敗する問題を防止"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:167
msgid "feat: laser tool with animations (thanks to @Kneemund)"
msgstr "新機能: アニメーション付きのレーザーツール (@Kneemund さんに感謝)"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:168
msgid "feat: tab overviews (thanks to @zefr0x)"
msgstr "新機能: タブの一覧表示 (@zefr0x さんに感謝)"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:169
msgid "feat: thumbnailer for .rnote files (thanks to @tiziodcaio)"
msgstr "新機能: .rnote ファイルのサムネイル生成 (@tiziodcaio さんに感謝)"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:170
msgid ""
"feat: keyboard clipboard paste at pointer location (thanks to @Kneemund)"
msgstr ""
"新機能: キーボードで貼り付けるとポインターの位置に貼り付け (@Kneemund さんに"
"感謝)"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:171
msgid "feat: multi-click selections (thanks to @Kneemund)"
msgstr "新機能: 複数回クリックによる選択 (@Kneemund さんに感謝)"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:172
msgid ""
"feat: new limit movements options for vertical-space tool (thanks to "
"@Doublonmousse)"
msgstr ""
"新機能: 垂直方向の空白ツールに移動を制限する新しいオプション (@Doublonmousse "
"さんに感謝)"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:173
msgid ""
"feat: confirmation prompt for file/folder trash action (thanks to @RayJW)"
msgstr ""
"新機能: ファイル/フォルダーをゴミ箱に移動する前の確認 (@RayJW さんに感謝)"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:174
msgid "feat: open workspace folder option (thanks to @Doublonmousse)"
msgstr ""
"新機能: ワークスペースのフォルダーを開くオプション (@Doublonmousse さんに感"
"謝)"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:175
msgid "feat: import of encrypted PDFs (thanks to @kq98)"
msgstr "新機能: 暗号化された PDF のインポート (@kq98 さんに感謝)"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:176
msgid ""
"improv: support keyboard and uncommon key shortcuts (thanks to @Kneemund)"
msgstr ""
"改善: キーボードや一般的でないキーのショートカットに対応 (@Kneemund さんに感"
"謝)"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:177
msgid ""
"improv: clipboard pasting on certain platforms like macOS (thanks to "
"@Doublonmousse)"
msgstr ""
"改善: macOS など一部のプラットフォームでのクリップボードからの貼り付け "
"(@Doublonmousse さんに感謝)"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:178
msgid "fix: selection handle sensitivity in \"single-selection\" mode"
msgstr "修正: 「1 つずつ選択」モードでの選択ハンドルの反応"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:179
msgid ""
"fix: unwanted activation of long-press gesture after zooming (thanks to "
"@Kneemund)"
msgstr ""
"修正: 拡大・縮小の後に長押しジェスチャーが意図せず反応する問題 (@Kneemund さ"
"んに感謝)"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:180
msgid "fix: allow view movement while having a selection"
msgstr "修正: 選択中でも表示を移動できるように"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:181
msgid ""
"fix: cli file collision resolution in non-interactive settings (thanks to "
"@LeSnake04)"
msgstr ""
"修正: 非対話環境での CLI のファイル名衝突の解決 (@LeSnake04 さんに感謝)"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:182
msgid "fix: missing tooltips (thanks to @Doublonmousse)"
msgstr "修正: 欠けていたツールチップ (@Doublonmousse さんに感謝)"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:183
msgid "fix: window shadows on Windows (thanks to @Doublonmousse)"
msgstr "修正: Windows でのウィンドウの影 (@Doublonmousse さんに感謝)"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:184
msgid "fix: .rnote file icons in file managers"
msgstr "修正: ファイルマネージャーでの .rnote ファイルのアイコン"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:185
msgid ""
"fix: selecting colors not working properly in certain cases (thanks to "
"@Kneemund)"
msgstr ""
"修正: 特定の状況で色の選択が正しく動作しない問題 (@Kneemund さんに感謝)"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:193
msgid "feat: add disable option for pen shortcuts (thanks to @Doublonmousse)"
msgstr ""
"新機能: ペンのショートカットを無効にするオプションを追加 (@Doublonmousse さん"
"に感謝)"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:194
msgid ""
"feat: add respect-borders option, improving size logic when pasting content "
"(thanks to @Doublonmousse)"
msgstr ""
"新機能: 枠線を考慮するオプションを追加し、貼り付け時のサイズの処理を改善 "
"(@Doublonmousse さんに感謝)"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:195
msgid ""
"feat: add improve-for-E-Paper option, showing current selected color as a "
"string"
msgstr ""
"新機能: 電子ペーパー向けの最適化オプションを追加し、選択中の色を文字で表示"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:196
msgid "improv: migrate to libadwaita based dialogs (thanks to @zefr0x)"
msgstr "改善: libadwaita ベースのダイアログに移行 (@zefr0x さんに感謝)"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:197
msgid ""
"improv: stroke modeler entirely rewritten in Rust! (thanks to @Doublonmousse)"
msgstr ""
"改善: ストロークのモデラーを Rust で完全に書き直し！ (@Doublonmousse さんに感"
"謝)"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:198
msgid "improv: zoom tool following the pointer (thanks to @JonathanGodar)"
msgstr "改善: 拡大・縮小ツールがポインターに追従 (@JonathanGodar さんに感謝)"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:199
msgid "improv: developers list in about window (thanks to @zefr0x)"
msgstr ""
"改善: 「Rnote について」ウィンドウに開発者の一覧を表示 (@zefr0x さんに感謝)"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:200
msgid ""
"improv: native file dialogs on Windows, macOS (thanks to @Doublonmousse)"
msgstr ""
"改善: Windows と macOS でネイティブのファイルダイアログを使用 "
"(@Doublonmousse さんに感謝)"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:201
msgid ""
"improv: gzip (de)compression optimizations, reducing file save/load times "
"(thanks to @anesthetice)"
msgstr ""
"改善: gzip の圧縮・展開を最適化し、ファイルの保存と読み込みを高速化 "
"(@anesthetice さんに感謝)"

#: crates/rnote-ui/data/app.metainfo.xml.in.in:202
msgid ""
"improv: prevent accidental resizes/moves when interacting with buttons in "
"the titlebar"
msgstr ""
"改善: タイトルバーのボタンの操作中にウィンドウが誤ってリサイズ・移動されるの"
